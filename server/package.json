{
  "name": "ai-interview-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "test": "node --test src/middleware/requireRole.test.js src/middleware/requireProviderAccess.test.js src/routes/api.test.js src/services/vacancyService.test.js src/services/tokenService.test.js src/services/mailService.test.js src/services/emailAuthService.test.js",
    "predev": "npm run db:migrate",
    "prestart": "npm run db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
